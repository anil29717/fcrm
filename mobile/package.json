  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:apk": "npx cross-env EAS_NO_VCS=1 npx eas-cli build --platform android --profile preview",
    "build:apk:local": "npx cross-env EAS_NO_VCS=1 npx eas-cli build --platform android --profile preview --local",
    "update:preview": "npx cross-env EAS_NO_VCS=1 npx eas-cli update --branch preview --message",
    "update:production": "npx cross-env EAS_NO_VCS=1 npx eas-cli update --branch production --message",
    "eas:login": "npx eas-cli login",
    "eas:init": "npx eas-cli init"
  },
  "private": true
